    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "next": "15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "prisma": "6.2.1",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
